# Names only; put real values into .env (never commit it).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
CORS_ORIGINS=
STORAGE_LOCAL_DIR=var/storage
ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_EMAIL=10
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_UPLOAD_PER_USER=30
RATE_LIMIT_LIFECYCLE_PER_USER=30

# Local Compose only; generate a random hex password (see README).
POSTGRES_PASSWORD=CHANGE_ME
APP_ENV=development
DEMO_MODE=false
# disabled (manual workflows), mock (requires DEMO_MODE), http_json (configured gateway)
VISION_PROVIDER=disabled
# For http_json, set all three; endpoint must be HTTPS.
# VISION_ENDPOINT=https://your-vision-gateway.example/analyze
# VISION_MODEL=your-model
# VISION_API_KEY=your-key
VISION_TIMEOUT_SECONDS=20
OPTIMIZATION_TIMEOUT_SECONDS=5
